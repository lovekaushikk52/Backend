<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="bg-zinc-900 w-full h-screen text-white p-10 gap-10">
        <form action="/login" method="post">
            <h1 class="text-3xl mb-5">Login ur account</h1>
            <input class="px-3 py-2 rounded-md outline-2 bg-transparent bg-zinc-800 outline-none" type="email" placeholder="email" name="email">
            <input class="px-3 py-2 rounded-md outline-2 bg-transparent bg-zinc-800 outline-none" type="password" placeholder="password" name="password">
            <input class="bg-yellow-400 rounded-md px-5 py-2 " type="submit" value="Login user">
        </form>
    </div>
</body>
</html>
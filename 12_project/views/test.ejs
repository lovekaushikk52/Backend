<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10 mb-2">
        <h1 class="text-3xl mb-5">Upload file</h1>
        <hr>
        <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data">
            
            <input class="bg-transparent text-sm " type="file" name="image">

            <input class="px-5 py-2 rounded-md bg-red-500 text-black text-sm mt-2" type="submit" value="upload">
        </form>
    </div>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex justify-end">
            <a class="bg-red-500 mb-3 px-3 py-2 rounded-md " href="/logout">Logout</a>
        </div>
        <h3 class="mb-5 text-2xl">You can <span class="text-red-400 font-italic">edit your post...</span></h3>

        <form action="/update/<%= post._id %>" method="post">
            <textarea 
            class="w-1/3 resize-none bg-transparent bg-zinc-900 border-2 rounded-md p-3 outline-none block rounded-md mb-3 scrollbar-none" 
            placeholder="What's in ur mind" 
            name="content" >
            <%= post.content %>
            </textarea>
            <input class="px-3 py-2 w-40 bg-yellow-500 text-black block rounded-md text-sm" type="submit" value="Update Post">
        </form>
        
    </div>
</body>
</html> 
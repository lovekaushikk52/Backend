<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h1 class="text-2xl mb-5 font-bold"> Upload Profile Pic</h1>
        <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data">

            <input class="bg-transparent rounded-md outline-none outline-2 px-3 py-2 text-sm" 
            type="file"
            placeholder="enter ur email"
            name="image">        

            <input class="px-5 py-2 rounded-md bg-red-700 text-sm" type="submit" value="Upload">
        </form>
    </div>
</body>
</html>
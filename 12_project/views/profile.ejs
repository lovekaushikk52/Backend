<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <div class="flex justify-end">
            <a class="bg-red-500 mb-3 px-3 py-2 rounded-md " href="/logout">Logout</a>
        </div>
        <h1 class="text-3xl"><span class="font-light text-red-400">Hello,</span> <%= user.name %>👋🏼 </h1>
        <h3 class="mb-5">u can create a new post</h3>

        <form action="/post" method="post">
            <textarea class="w-1/3 resize-none bg-transparent bg-zinc-900 border-2 rounded-md p-3 outline-none block rounded-md mb-3" placeholder="What's in ur mind" name="content" ></textarea>
            <input class="px-3 py-2 w-40 bg-blue-500 block rounded-md text-sm" type="submit" value="submit">
        </form>

        <div class="posts mt-3">
            <h2 class="text-xl text-gray-400">Your Posts</h3>
                <div class="postcontainer mt-3">
                    <% user.posts.reverse().forEach(function(post){ %>
                        <div class="post w-1/3 p-4 border-2 border-gray-400 rounded-md bg-zinc-700 mb-4">
                        <h3 class="text-blue-400 mb-2"> <%=user.username%></h3>
                        <p class="text-sm tracking-tight"><%=post.content %></p>
                        <div class="btns mt-5 gap-4 flex">
                            <a class="text-blue-400" href="">Like</a>
                            <a class="text-zinc-400" href="">Edit</a>
                        </div>
                    </div>
                   <% }) %>
                </div>
        </div>
        
    </div>
</body>
</html> 
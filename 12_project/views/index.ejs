<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    
    <div class="w-full min-h-screen bg-zinc-900 text-white p-10">
        <h1 class="text-3xl mb-5"> Create User</h1>
        <form action="/register" method="post">
            <input class=" bg-transparent rounded-md outline-none outline-2 px-3 py-2" type="text"
            placeholder="enter ur username"
            name="username">

            <input class="bg-transparent rounded-md outline-none outline-2 px-3 py-2" 
            type="text"
            placeholder="enter ur name"
            name="name">

            <input class="bg-transparent rounded-md outline-none outline-2 px-3 py-2" 
            type="password"
            placeholder="enter ur password"
            name="password">
            
            <input class=" bg-transparent rounded-md outline-none outline-2 px-3 py-2" 
            type="number"
            placeholder="enter ur age"
            name="age">

            <input class="bg-transparent rounded-md outline-none outline-2 px-3 py-2" 
            type="email"
            placeholder="enter ur email"
            name="email">


            <input class="px-5 py-2 rounded-md bg-blue-500" type="submit" value="create user">
        </form>
    </div>
</body>
</html>
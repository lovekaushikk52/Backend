<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 text-white p-10 gap-10 ">
        <div class="nav mb-10">
            <a class="text-xl text-blue-500" href="/read">read page</a>
        </div>
        <h1 class="tracking-tighter text-3xl mb-5">Update User</h1>

        <form action="/update/<%= user._id %>" method="post">
            <input class="px-7 py-3 border-2 bg-transparent outline-none rounded-lg" type="text" placeholder="name" name="name" value="<%= user.name%>">
            <input class="px-7 py-3 border-2 bg-transparent outline-none rounded-lg" type="text" placeholder="Email" name="email" value="<%= user.email%>" >
            <input class="px-7 py-3 border-2 bg-transparent outline-none rounded-lg" type="text" placeholder="image url" name="image" value="<%= user.image%>">
            <input class="px-7 py-3 bg-yellow-500 rounded-lg ml-3 text-black" type="submit" value="update user">
        </form>
    </div>
</body>
</html>


            
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="w-full h-full bg-zinc-900 text-white p-10 ">
        <a class="text-xl text-blue-500 mt-10" href="/">Back to home page</a>
        <h1 class="tracking-tighter text-3xl mb-5">All users...</h1>

        <div class="users flex gap-10 flex-wrap">
            <% if (users.length>0){ %>

                <% users.forEach(function(user){ %>

                <div class="user w-72 p-4 bg-zinc-800 rounded-lg ">

                    <div class="w-full h-72 bg-zinc-600 rounded-lg overflow-hidden">
                        <img class="w-full h-full object-cover" src="<%= user.image %>" alt="not found">
                    </div>

                    <h3 class="text-xl tracking-tighter mt-3"><%= user.name %></h3>
                    <h5 class="text-zinc-500"><%= user.email %></h5>

                    <div class="flex justify-between ml-5">
                        <a class="text-zinc-500" href="/edit/<%= user._id%>">Edit user</a>
                        <a class="text-red-500" href="/delete/<%= user._id %>">Delete user</a>
                    </div>
                
                </div>

            <% }) %>
            <% }else{ %>
                <h3 class="text-zinc-500">no users yet</h3>
            <% } %>
            
            
        </div>

    </div>
</body>
</html>